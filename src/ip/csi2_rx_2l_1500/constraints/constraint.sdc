set device "LFCPNX-100"
set device_int "jd5d80"
set package "CBG256"
set package_int "CBG256"
set speed "9_High-Performance_1.0V"
set speed_int "12"
set operation "Industrial"
set family "LFCPNX"
set architecture "jd5d00"
set partnumber "LFCPNX-100-9CBG256I"
set WRAPPER_INST "lscc_dphy_rx_inst"
set FAMILY "LFCPNX"
set DEVICE "LFCPNX-100"
set SIM_MODE 0
set RX_TYPE "CSI2"
set DPHY_RX_IP "LATTICE"
set NUM_RX_LANE 2
set RX_GEAR 8
set DESKEW_EN "DISABLED"
set BYTECLK_MHZ 187
set BYTECLK_MHZ_FLOAT 187.500000
set RX_LP_M_FACTOR 1
set RX_LP_D_FACTOR 75
set RX_CLK_MODE "HS_ONLY"
set SYNCCLK_MHZ 150.000000
set HSEL "DISABLED"
set DYN_DEL_EN "OFF"
set DDRDLL_EN "OFF"
set DDRDLL_SHARE "OFF"
set DYN_SEQ_ON "OFF"
set TEST_PATTERN "0b10000000001000000000000000000000"
set CIL_BYPASS "CIL_BYPASSED"
set LANE_ALIGN "ON"
set PARSER "ON"
set AXI4 "OFF"
set LMMI "OFF"
set CSRCMD_IMPL "SYNC"
set CRC_CHECK "OFF"
set DYNAMIC_RECONFIG "OFF"
set REF_DT "6'h30"
set VCX_ON "OFF"
set BACK2BACK "OFF"
set DROP_NULL "OFF"
set DATA_SETTLE_CYC 15
set T_DATA_SETTLE_INT 15
set T_DATA_SETTLE "0b001111"
set T_CLK_SETTLE_INT 22
set T_CLK_SETTLE "0b010110"
set DYN_DATSETTLE "OFF"
set FIFO_DEPTH 4
set FIFO_TYPE "HARD_IP"
set RX_FIFO "ON"
set RX_FIFO_TYPE "PINGPONG"
set RX_FIFO_IMPL "HARD_IP"
set RX_FIFO_DEPTH 256
set NUM_QUE_ENT 4
set RX_FIFO_PKT_DLY 8
set RX_FIFO_CTR_WIDTH 3
set FR_FIFO_CLKMODE "DC"
set FIFO_IF "ALIGNED"
set RX_FIFO_MISC "OFF"
set DELAYB_DELMODE "ECLK_CENTERED"
set DELAYB_COARSEDEL "0NS"
set DELAYB_DELVAL "26"
set CTRL_DYNDEL "OFF"


if { $radiant(stage) == "presyn" } {

  if {$CIL_BYPASS == "CIL_ENABLED"} {
    set_false_path -through [get_pins {lscc_dphy_rx_inst/CIL_TOP.u_dphy_rx_core_cil/*fr_fifo*/RPReset}]
    set_false_path -through [get_pins {lscc_dphy_rx_inst/CIL_TOP.u_dphy_rx_core_cil/*fr_fifo*/Reset}]
    set_false_path -through [get_pins {lscc_dphy_rx_inst/pd_dphy*}]
  } else {
 
    if {$RX_FIFO == "ON"} {   
      set_false_path -through [get_pins {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/u_rx_fifo/rx_fifo_*/*fr_fifo*/RPReset}]
      set_false_path -through [get_pins {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/u_rx_fifo/rx_fifo_*/*fr_fifo*/Reset}]
	  
      if {($RX_FIFO_TYPE == "QUEUE")} {
        set_false_path -through [get_pins {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/u_rx_fifo/rx_fifo_*/rx_que/RPReset}]
        set_false_path -through [get_pins {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/u_rx_fifo/rx_fifo_*/rx_que/Reset}]
      }
    }
  }

  if {$LANE_ALIGN == "ON"} {
    set_false_path -through [get_pins {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/LANE_ALIGN_ON.l_align/*.l_align_fifo_lane/Reset}]
  }

} elseif { $radiant(stage) == "premap" } {
#-- Notes:
# - lmmi_clk_i and clk_byte_fr_i are treated as asynchronous inside the IP and
#         proper CDC are already handled inside the IP.
# All clocks clk_lp_ctrl_i, clk_byte_fr_i, sync_clk_i, lmmi_clk_i,
#         clk_hs_sync_w/clk_byte_hs_o/clk_byte_o are treated as asynchronous 
#         inside the IP and proper CDC are already handled inside the IP.
# If these clocks are also asynchronous in your system level design, you can
# set the clock groups as asynchronous. See sample below:
#
# set_clock_groups -asynchronous -group [get_clocks lmmi_clk_i]  \
#                                 -group [get_clocks clk_byte_fr_i]   \
#                                 -group [get_clocks clk_lp_ctrl_i]   \
#                                 -group [get_clocks sync_clk_i]   \
#                                 -group [get_clocks clk_hs_sync_w]   \
#                                 -group [get_clocks clk_byte_hs_o_c]
#--


if {($DPHY_RX_IP == "LATTICE")} {
  #  Can be used to define ECLK for Avant.
  #  Usable when you see INF or create_generated_clock constraint for byte_clock 
  #  is tagged IGNORED in the STA report. Rename clk_p_io with the system-level
  #  DPHY Rx clock name. Define in PDC. 
  #  Issue only exists in Avant. This is not needed in Nexus since ECLK source
  #  is automatically detected.
  if {($FAMILY == "LAV-AT")} {
    create_generated_clock -name {clk_hs_w}      -source \
                                                 [get_pins -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_AVANT.u_lscc_mipi_dphy_soft_rx/u_mipi_clk.IOA_inst/IOPAD}] \
                                                 -divide_by 1 \
                                                 [get_nets -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_AVANT.u_lscc_mipi_dphy_soft_rx/clk_hs_w}]

  }

  # Redefining generated clock. This is not automatically generated by SW.
  if {($FAMILY == "LAV-AT" && $DYN_DEL_EN == "ON")} {
    create_generated_clock -name {byte_clk_w_div4} -source [get_pins -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_AVANT.u_lscc_mipi_dphy_soft_rx/u_eclkdiv/ECLKDIVOUT}] -divide_by 4 [get_nets -hierarchical {*u_lscc_mipi_dphy_soft_rx/byte_clk_w_div4*}]
  }

  # Manually defined since SW does not support automatic generation
  if {($RX_CLK_MODE == "HS_LP")} {
    if {$FAMILY == "LAV-AT"} {
      create_generated_clock -name {lp_rx_clk_p_o} -source \
        [get_pins -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_AVANT.u_lscc_mipi_dphy_soft_rx/u_mipi_clk.IOA_inst/IOPAD}] \
        -multiply_by $RX_LP_M_FACTOR -divide_by $RX_LP_D_FACTOR \
        [get_pins -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_AVANT.u_lscc_mipi_dphy_soft_rx/u_mipi_clk.IOA_inst/IN_LP}]
      
      create_generated_clock -name {lp_rx_clk_n_o} -source \
        [get_pins -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_AVANT.u_lscc_mipi_dphy_soft_rx/u_mipi_clk.IOA_inst/IOPAD}] \
        -multiply_by $RX_LP_M_FACTOR -divide_by $RX_LP_D_FACTOR \
        [get_pins -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_AVANT.u_lscc_mipi_dphy_soft_rx/u_mipi_clk.IOB_inst/IN_LP}]
    } else {
      create_generated_clock -name {lp_rx_clk_p_o} -source \
        [get_pins -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_NX.u_lscc_mipi_dphy_soft_rx/u_mipi_clk.IOA_inst/B}] \
        -multiply_by $RX_LP_M_FACTOR -divide_by $RX_LP_D_FACTOR \
        [get_pins -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_NX.u_lscc_mipi_dphy_soft_rx/u_mipi_clk.IOA_inst/INLP}]
      
      create_generated_clock -name {lp_rx_clk_n_o} -source \
        [get_pins -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_NX.u_lscc_mipi_dphy_soft_rx/u_mipi_clk.IOA_inst/B}] \
        -multiply_by $RX_LP_M_FACTOR -divide_by $RX_LP_D_FACTOR \
        [get_pins -hierarchical {lscc_dphy_rx_inst/NOCIL_TOP.u_dphy_rx_core/u_dphy_rx_wrap/SOFT_RX.SOFT_RX_NX.u_lscc_mipi_dphy_soft_rx/u_mipi_clk.IOB_inst/INLP}]

    }
  }

}

## Constraints when Nexus HARD_IP is used 
set WR_CLK_PERIOD  [expr {(1000/$BYTECLK_MHZ_FLOAT)}]
set RD_CLK_PERIOD  [expr {(1000/$BYTECLK_MHZ_FLOAT)}]

set WR_MAXDLY [expr {$WR_CLK_PERIOD*0.8}]
set RD_MAXDLY [expr {$RD_CLK_PERIOD*0.8}]

## Constraints for others
set WR_1P8MAXDLY [expr {$WR_CLK_PERIOD*1.8}]

#-- RESET
# Constraints for reset synchronizer (CDC library)
# Constrain the data path for CDC registers when SYNC_STAGE = 2
if {$CIL_BYPASS == "CIL_BYPASSED"} {
  if {($FAMILY != "LAV-AT")} {
    set_false_path -to [get_pins -hierarchical {*u*_rstsync/*lscc_reset*/*u_lscc_reset_async/rstn_sync*/LSR}]
  } else {
    set_false_path -to [get_pins -hierarchical {*u*_rstsync/*lscc_reset*/*u_lscc_reset_async/rstn_sync*/CD}]
  }
}

# As recommended by FIFO_DC foundation IP
if {($FAMILY != "LAV-AT" && $RX_FIFO_IMPL == "HARD_IP")} {
  set_max_delay -datapath_only -from [get_cells -hierarchical */*.FIFO16K_MODE_inst] -to [get_cells -hierarchical */*.full_r*.*_inst]   $WR_MAXDLY 
  set_max_delay -datapath_only -from [get_cells -hierarchical */*.FIFO16K_MODE_inst] -to [get_cells -hierarchical */*.afull_r*.*_inst]  $WR_MAXDLY 
  set_max_delay -datapath_only -from [get_cells -hierarchical */*.FIFO16K_MODE_inst] -to [get_cells -hierarchical */*.empty_r*.*_inst]  $RD_MAXDLY 
  set_max_delay -datapath_only -from [get_cells -hierarchical */*.FIFO16K_MODE_inst] -to [get_cells -hierarchical */*.aempty_r*.*_inst] $RD_MAXDLY 
  set_false_path -from [get_pins -hierarchical */*.FIFO16K_MODE_inst/EMPTY] -to [get_pins -hierarchical */*.FIFO16K_MODE_inst/EMPTYI] 
  set_false_path -from [get_pins -hierarchical */*.FIFO16K_MODE_inst/FULL] -to [get_pins -hierarchical */*.FIFO16K_MODE_inst/FULLI] 
  
  ## Additional constraints when Output Register is Enabled 
# DNG-32396
#  set_max_delay -datapath_only -from [get_cells -hierarchical */*.empty_r*.*_inst] -to [get_cells -hierarchical */*.empty_sync_r*.*_inst]   $RD_MAXDLY 
#  set_max_delay -datapath_only -from [get_cells -hierarchical */*.aempty_r*.*_inst] -to [get_cells -hierarchical */*.aempty_sync_r*.*_inst] $RD_MAXDLY
  set_max_delay -datapath_only -from [get_cells -hierarchical */*.empty_sync_r*.*_inst] -to [get_cells -hierarchical */*.empty_r*.*_inst]   $RD_MAXDLY 
  set_max_delay -datapath_only -from [get_cells -hierarchical */*.aempty_sync_r*.*_inst] -to [get_cells -hierarchical */*.aempty_r*.*_inst] $RD_MAXDLY
# UCSIP-11018
  set_max_delay -datapath_only -from [get_cells -hierarchical */*.FIFO16K_MODE_inst] -to [get_cells -hierarchical */*.empty_sync_r*.*_inst] $RD_MAXDLY
  set_max_delay -datapath_only -from [get_cells -hierarchical */*.FIFO16K_MODE_inst] -to [get_cells -hierarchical */*.aempty_sync_r*.*_inst] $RD_MAXDLY
#  set_max_delay -datapath_only -from [get_cells -hierarchical */*.FIFO16K_MODE_inst] -to [get_pins -hierarchical {*aempty_sync_r*.ff_inst/LSR}] $RD_MAXDLY 
#  set_max_delay -datapath_only -from [get_cells -hierarchical */*.FIFO16K_MODE_inst] -to [get_pins -hierarchical  {*empty_sync_r*.ff_inst/LSR}] $RD_MAXDLY
  set_max_delay -datapath_only -from [get_pins -hierarchical {*/*.aempty_r*.*_inst/Q} ] $RD_MAXDLY
}


if {$LANE_ALIGN == "ON"} {
  set_max_delay -datapath_only -from [get_pins -hierarchical {*fifo_rst*/Q}] -to [get_pins -hierarchical {*FIFO*_MODE_inst/RSTW \
                                                                                                           *FIFO*_MODE_inst/RPRST}] $WR_1P8MAXDLY
}

if {($FAMILY != "LAV-AT")} { 

  if {$CIL_BYPASS != "CIL_ENABLED"} {
    if {$RX_FIFO_IMPL == "HARD_IP"} {
# Improvement for UCSIP-11018
#      set_false_path -to [get_pins -hierarchical {*aempty_sync_r*/LSR}]
#      set_false_path -to [get_pins -hierarchical {*empty_sync_r*/LSR}]

      set_false_path -from [get_pins -hierarchical {*u2_rstsync/lscc_reset_inst/async_reset_mode.u_lscc_reset_async/rstn_sync*/Q}] \
                     -to   [get_pins -hierarchical {*fr_fifo*/*/*/_HARD_IP*/*/*.FIFO16K_MODE_inst/RSTW \
                                                    *fr_fifo*/*/*/_HARD_IP*/*/*.FIFO16K_MODE_inst/RPRST}]

      set_false_path -from [get_pins -hierarchical {*u2_rstsync/lscc_reset_inst/async_reset_mode.u_lscc_reset_async/rstn_sync*/Q}] \
                     -to   [get_pins -hierarchical {*fr_fifo*/*/*/_HARD_IP*/*wr_pong_r*.ff_inst/LSR }]

    } else {
      set_false_path -from [get_pins -hierarchical {*u2_rstsync/lscc_reset_inst/async_reset_mode.u_lscc_reset_async/rstn_sync*/Q}] \
                     -to   [get_pins -hierarchical {*fr_fifo*/*/*/_FABRIC*/*wr_addr_r*.ff_inst/LSR \
                                                    *fr_fifo*/*/*/_FABRIC*/*rp_sync*_r*.ff_inst/LSR \
                                                    *fr_fifo*/*/*/_FABRIC*/*full_r*.ff_inst/LSR \
                                                    *fr_fifo*/*/*/_FABRIC*/*wr_grey_sync_r*.ff_inst/LSR}]
    }
  #--end of soft CIL
  } else {
    set_false_path -through [get_nets -hierarchical {*rprst_r*}]

    set_false_path -from [get_pins -hierarchical {*u_dphy_rx_core_cil/lane0_stop_state*/Q}] \
                   -to   [get_pins -hierarchical {*fr_fifo*/*/*/_HARD_IP*/*/*.FIFO16K_MODE_inst/RSTW \
                                                  *fr_fifo*/*/*/_HARD_IP*/*/*.FIFO16K_MODE_inst/RPRST}]
  #--end of hard CIL
  }
#--end of Nexus
} else {
    if {$RX_FIFO_IMPL != "HARD_IP"} {
      set_false_path -from [get_pins -hierarchical {*u2_rstsync/lscc_reset_inst/async_reset_mode.u_lscc_reset_async/rstn_sync*/Q \
                                                    *u_dphy_rx_wrap/skewcal_det_rise_r*/Q}] \
                     -to   [get_pins -hierarchical {*fr_fifo*/*/*/_FABRIC*/*rp_sync*_r*/CD \
                                                    *fr_fifo*/*/*/_FABRIC*/*af_flag_ext_r*/CD \
                                                    *fr_fifo*/*/*/_FABRIC*/*af_flag_r*/CD \
                                                    *fr_fifo*/*/*/_FABRIC*/*full_ext_r*/CD \
                                                    *fr_fifo*/*/*/_FABRIC*/*full_r*/CD \
                                                    *fr_fifo*/*/*/_FABRIC*/*wr_addr_r*/CD \
                                                    *fr_fifo*/*/*/_FABRIC*/*wr_addr_arith_r*/CD \
                                                    *fr_fifo*/*/*/_FABRIC*/*wr_grey_sync_r*/CD}]
    }
#--end of Avant
}
#-

if {($DPHY_RX_IP != "LATTICE")} {
  set_false_path -to [get_pins -hierarchical {UTXRD0EN U1TXREQ U2TXREQ U3TXREQ}]  
  set_false_path -through [get_pins -hierarchical {UCTXUPSC UTXSKD0N U1TXSK U2TXSKC U3TXSKC}]
#--end of hard D-PHY
} else {

  set_false_path -through [get_pins -hierarchical {HSRXEN}]  

  set_false_path -through [get_nets -hierarchical {*u_lscc_gddr_sync/ddr_reset_*}]

  if {$RX_CLK_MODE == "HS_LP"} {
    if {$FAMILY == "LAV-AT"} {
      set_false_path -to   [get_pins -hierarchical {*lp_hs_ctrl_clk/hs_en_o/CD}]
    } else {
      set_false_path -to   [get_pins -hierarchical {*lp_hs_ctrl_clk/hs_en_o*.ff_inst/LSR}]
    }
  }

  if {($FAMILY == "LAV-AT")} { 
    set_false_path -to [get_pins -hierarchical {*u_eclkdiv*/RST}]

    if {($DYN_DEL_EN == "ON")} {
      set_false_path -to [get_pins -hierarchical {*u_delay_data_line*/LSR}]
    }

  } else {
    set_false_path -to [get_pins -hierarchical {*u_eclkdiv*/DIVRST}]
  }

  set_false_path -to [get_pins -hierarchical {*u_IDDRX4_data_line*/RST}]
																		 
#--end of soft D-PHY
}


if {$CIL_BYPASS == "CIL_BYPASSED"} {

  #-- LP-HS Controller
  if {($DPHY_RX_IP != "LATTICE")} {
    if {$RX_CLK_MODE == "HS_LP"} {
      set_false_path -through [get_nets -hierarchical {*term_clk_en* \
                                                       *uctxupsc}]   \
                     -to      [get_pins -hierarchical {*termclken_2ffsync/*/*/*dout_cc*.ff_inst/DF}]
    }

    set_false_path -to  [get_pins -hierarchical {*hsden_2ffsync/*/*/*dout*.ff_inst/LSR}]
    set_false_path -to  [get_pins -hierarchical {*u_dphy_rx_wrap/hs_d_en_stb_q_r*.ff_inst/LSR}]


  #--end of hard D-PHY, soft CIL
  } else {
    set_false_path -through [get_nets -hierarchical {*lp_rx_p_i*      \
                                                     *lp_rx_n_i*      \
                                                     *term_en_*    }]   \
                   -to      [get_pins -hierarchical {*.u_delay_data_line/A}] 


    if {$radiant(synthesis) == "synpro"} {
      set_false_path -through [get_nets -hierarchical {*c_state*    }]   \
                     -to      [get_pins -hierarchical {*.u_delay_data_line/A}]

      set_false_path -from    [get_pins -hierarchical {*c_state*/Q    }]   \
                     -to      [get_pins -hierarchical {*.u_delay_data_line/A}]

    } else {
        if {($FAMILY != "LAV-AT")} {
          set_false_path -from    [get_pins -hierarchical {*c_state*/Q    }]   \
                         -to      [get_pins -hierarchical {*.u_delay_data_line/A}]
        }
    } 

    if {($FAMILY == "LAV-AT")} {

      set_false_path -from [get_pins -hierarchical {*rxcsr_datsettlecyc_r*/Q}] \
                     -to   [get_pins -hierarchical {*rx_global_ctrl_inst/*settle_cnt_lane0*/D}]

      set_false_path -through [get_nets -hierarchical {*term_d*_en*}] \
                     -to      [get_pins -hierarchical {*termd0en_2ffsync/*/*/*.dout_cc*/D}]

      set_false_path -to      [get_pins -hierarchical {*lprxp_2ffsync/*/*/*dout_cc*/D \
                                                       *lprxn_2ffsync/*/*/*dout_cc*/D}]

      if {($DYN_DEL_EN == "ON")} {
        set_false_path -to      [get_pins -hierarchical {*hsdis_2ffsync/*/*/*dout_cc*/D}]
        set_false_path -to      [get_pins -hierarchical {*hsen_2ffsync/*/*/*dout_cc*/D}]
        set_false_path -through [get_nets -hierarchical {*dphy_cfg_num_lanes*}] \
                       -to      [get_pins -hierarchical {*u_lscc_mipi_dphy_soft_rx/*cfg_num_lanes_r*/D}]
      }

      if {($RX_CLK_MODE == "HS_ONLY")} { 
        set_false_path -through [get_nets -hierarchical {*term_clk_en*        \
                                                         *term_d*_en_*    }]   \
                       -to      [get_pins -hierarchical {*.u_IDDRX4_data_line/D}]
	    
        if {$radiant(synthesis) == "synpro"} { 
          set_false_path -through [get_nets -hierarchical {*c_state*}]   \
                         -to      [get_pins -hierarchical {*.u_IDDRX4_data_line/D}]
        }
      #--end of HS-ONLY
      } else {

        set_false_path -through [get_nets -hierarchical {*term_clk_en*}]   \
                       -to      [get_pins -hierarchical {*termclken_2ffsync/*/*/*dout_cc*/D}]

        set_false_path -from [get_pins -hierarchical {*c_state*/Q}]   \
                       -to   [get_pins -hierarchical {*.u_IDDRX4_data_line/D}]
      #--end of HS-LP
      }

      set_false_path -to  [get_pins -hierarchical {*hsden_2ffsync/*/*/*dout*/CD}]
      set_false_path -to  [get_pins -hierarchical {*u_dphy_rx_wrap/hs_d_en_stb_q_r*/CD}]

    #--end of Avant
    } else {

        set_false_path -from [get_pins -hierarchical {*rxcsr_datsettlecyc_r*/Q}] \
                       -to   [get_pins -hierarchical {*rx_global_ctrl_inst/*settle_cnt_lane0*.ff_inst/DF}]

        set_false_path -through [get_nets -hierarchical {*term_d*_en*}] \
                       -to      [get_pins -hierarchical {*termd0en_2ffsync/*/*/*.dout_cc*.ff_inst/DF}]

        set_false_path -to      [get_pins -hierarchical {*lprxp_2ffsync/*/*/*dout_cc*.ff_inst/DF \
                                                         *lprxn_2ffsync/*/*/*dout_cc*.ff_inst/DF}]

        if {$RX_CLK_MODE == "HS_LP"} {
          set_false_path -through [get_nets -hierarchical {*term_clk_en*}]   \
                         -to      [get_pins -hierarchical {*termclken_2ffsync/*/*/*dout_cc*.ff_inst/DF}]
        }

        set_false_path -to  [get_pins -hierarchical {*hsden_2ffsync/*/*/*dout*.ff_inst/LSR}]
        set_false_path -to  [get_pins -hierarchical {*u_dphy_rx_wrap/hs_d_en_stb_q_r*.ff_inst/LSR}]

    #--end of Nexus
    }
                   
  #--end of soft D-PHY
  }
  #-- 

  # RX FIFO
  if {($FAMILY != "LAV-AT")} {
    if {$RX_FIFO == "ON"} { 

      if {($RX_FIFO_TYPE == "QUEUE")} {
        if {($radiant(synthesis) == "synpro")} {
          set_max_delay -datapath_only -from [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/Q}] \
                                       -to   [get_pins -hierarchical {*rx_que/*/*/_FABRIC*/distmem_ram*.ramw_inst/WD0}] $WR_1P8MAXDLY
          set_max_delay -datapath_only -from [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/Q}] \
                                       -to   [get_pins -hierarchical {*rx_que/*/*/_FABRIC*/distmem_ram*.ramw_inst/WD1}] $WR_1P8MAXDLY
          set_max_delay -datapath_only -from [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/Q}] \
                                       -to   [get_pins -hierarchical {*rx_que/*/*/_FABRIC*/distmem_ram*.ramw_inst/WD2}] $WR_1P8MAXDLY
          set_max_delay -datapath_only -from [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/Q}] \
                                       -to   [get_pins -hierarchical {*rx_que/*/*/_FABRIC*/distmem_ram*.ramw_inst/WD3}] $WR_1P8MAXDLY
        } elseif {($radiant(synthesis) == "lse")} {
          set_max_delay -datapath_only -from [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/Q}] \
                                       -to   [get_pins -hierarchical {*rx_que/*/*/_FABRIC*/wr_addr_r*.ramw_inst/WD0}] $WR_1P8MAXDLY
          set_max_delay -datapath_only -from [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/Q}] \
                                       -to   [get_pins -hierarchical {*rx_que/*/*/_FABRIC*/wr_addr_r*.ramw_inst/WD1}] $WR_1P8MAXDLY
          set_max_delay -datapath_only -from [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/Q}] \
                                       -to   [get_pins -hierarchical {*rx_que/*/*/_FABRIC*/wr_addr_r*.ramw_inst/WD2}] $WR_1P8MAXDLY
          set_max_delay -datapath_only -from [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/Q}] \
                                       -to   [get_pins -hierarchical {*rx_que/*/*/_FABRIC*/wr_addr_r*.ramw_inst/WD3}] $WR_1P8MAXDLY
        } 
        set_false_path -from [get_pins -hierarchical {*rxcsr_datsettlecyc_r*/Q}] \
                       -to   [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*.ff_inst/DF \
                                                      */u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*.ff_inst/CE}]

        if {$RX_FIFO_IMPL == "LUT"} {
          set_false_path -from [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/*.ramw_inst/WDO*}] \
                         -to   [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/DIST.out_raw*.ff_inst/DF}]
        }

        if {($DPHY_RX_IP != "LATTICE")} {
          set_false_path -to [get_pins -hierarchical {*stb_data_neg*.ff_inst/LSR}]
          set_false_path -to [get_pins -hierarchical {*hs_sync_neg*.ff_inst/LSR}]
        }

      #--end of if {($RX_FIFO_TYPE == "QUEUE")} 
      }

      if {($RX_FIFO_TYPE == "PINGPONG")} {
        set_false_path -from [get_nets -hierarchical {*reset_pp*}]
        if {$RX_FIFO_IMPL == "HARD_IP"} {
          set_false_path -from [get_pins -hierarchical {*wr_pp_sel*.ff_inst/Q}] \
                         -to   [get_pins -hierarchical {*rx_fifo_pp_inst/*/*/*/_HARD_IP*/*/*.FIFO16K_MODE_inst/WE \
                                                        *rx_fifo_pp_inst/*/*/*/_HARD_IP*/*wr_pong_r*.ff_inst/CE}]

          if {($radiant(synthesis) == "lse")} {
            set_false_path -from [get_pins -hierarchical {*wr_pp_sel*.ff_inst/Q}] \
                           -to   [get_pins -hierarchical {*rx_fifo_pp_inst/*/*/*/_HARD_IP*/*wr_pong_r*.ff_inst/DF}]
          } 

        } else {
          set_false_path -from [get_pins -hierarchical {*wr_pp_sel*.ff_inst/Q}] \
                         -to   [get_pins -hierarchical {*rx_fifo_pp_inst/*/*/*/_FABRIC*/*rp_sync*_r*/DF \
                                                        *rx_fifo_pp_inst/*/*/*/_FABRIC*/*af_flag_ext_r*/DF \
                                                        *rx_fifo_pp_inst/*/*/*/_FABRIC*/*af_flag_r*/DF \
                                                        *rx_fifo_pp_inst/*/*/*/_FABRIC*/*full_ext_r*/DF \
                                                        *rx_fifo_pp_inst/*/*/*/_FABRIC*/*full_r*/DF \
                                                        *rx_fifo_pp_inst/*/*/*/_FABRIC*/*wr_addr_r*/DF \
                                                        *rx_fifo_pp_inst/*/*/*/_FABRIC*/*wr_addr_arith_r*/DF \
                                                        *rx_fifo_pp_inst/*/*/*/_FABRIC*/*wr_grey_sync_r*/DF}]
          if {$RX_FIFO_IMPL == "LUT"} {
            set_false_path -from [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/*.ramw_inst/WDO*}] \
                           -to   [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/DIST.out_raw*.ff_inst/DF}]
          }
        }
      
        if {($DPHY_RX_IP != "LATTICE")} {
          set_false_path -to [get_pins -hierarchical {*stb_data_neg*.ff_inst/LSR}]
          set_false_path -to [get_pins -hierarchical {*wr_en_pp*_neg*.ff_inst/LSR}]
          set_false_path -from [get_pins -hierarchical {*wr_pp_sel*.ff_inst/Q}] \
                         -to   [get_pins -hierarchical {*rx_fifo_pp_inst/wr_en_pp*_neg*.ff_inst/DF}]


        }
      #--end of if {($RX_FIFO_TYPE == "PINGPONG")}
      }

      if {$RX_FIFO_TYPE == "SINGLE" && $FR_FIFO_CLKMODE == "DC"} {
        if {$RX_FIFO_IMPL == "LUT"} {
          set_false_path -from [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/*.ramw_inst/WDO*}] \
                         -to   [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/DIST.out_raw*.ff_inst/DF}]
        }

        if {($DPHY_RX_IP != "LATTICE")} {
          set_false_path -to [get_pins -hierarchical {*stb_data_neg*.ff_inst/LSR}]
          set_false_path -to [get_pins -hierarchical {*hs_sync_neg*.ff_inst/LSR}]
        }

      #--end of if {($RX_FIFO_TYPE == "SINGLE")}
      }

      if {($RX_FIFO_MISC == "ON")} {
        set_false_path -to [get_pins -hierarchical {*rx_fifo_errstat_inst/hs_sync_r*.ff_inst/LSR \
                                                    *rx_fifo_errstat_inst/fifo*_dly_stb*.ff_inst/LSR \
                                                    *rx_fifo_errstat_inst/fifo*_ovflw_stb*.ff_inst/LSR}]
        set_false_path -to [get_pins -hierarchical {*rx_fifo_errstat_inst/stb_empty*_2ffsync/*/*/*.dout_cc*.ff_inst/LSR}]
        set_false_path -from [get_pins -hierarchical {*rx_fifo_errstat_inst/fr_hssync_2ffsync/*/*/*.dout*.ff_inst/Q \
                                                      *rx_fifo_errstat_inst/hs_sync_q*.ff_inst/Q}] \
                       -to   [get_pins -hierarchical {*rx_fifo_errstat_inst/fifo*_ovflw_stb*.ff_inst/CE}]
      }

    #--end of if {$RX_FIFO == "ON"}
    }

    if {$RX_FIFO_IMPL != "HARD_IP"} {
      set_false_path -from    [get_pins -hierarchical {*rxcsr_datsettlecyc_r*/Q}] \
                     -to      [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/*full_r*/DF \
                                                       *u_rx_fifo/*/*/*/*/_FABRIC*/*wr_addr_r*/DF \
                                                       *u_rx_fifo/*/*/*/*/_FABRIC*/*wr_grey_sync_r*/DF}]
    } else {
      set_false_path -from [get_pins -hierarchical {*rxcsr_datsettlecyc_r*/Q}] \
                     -to   [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_HARD_IP*/*/*.FIFO16K_MODE_inst/WE \
                                                    *u_rx_fifo/*/*/*/*/_HARD_IP*/*wr_pong_r*.ff_inst/CE}]
    }
    
    set_false_path -to     [get_pins -hierarchical {*rx_fifo_errstat_inst/fr_hssync_2ffsync/*/*/*dout_cc*.ff_inst/DF}]

  #--end of Nexus
  } else {
    if {$RX_FIFO == "ON"} { 
      if {($RX_FIFO_TYPE == "QUEUE")} {
        if {($radiant(synthesis) == "synpro")} {
          set_max_delay -datapath_only -from [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/Q}] \
                                       -to   [get_pins -hierarchical {*rx_que/*/*/_FABRIC*/distmem_ram*.dpram_inst/DI*}] $WR_1P8MAXDLY
        } elseif {($radiant(synthesis) == "lse")} { 
          set_max_delay -datapath_only -from [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/Q}] \
                                       -to   [get_pins -hierarchical {*rx_que/*/*/_FABRIC*/wr_addr_r*.dpram_inst/DI*}] $WR_1P8MAXDLY
        } 
        set_false_path -from [get_pins -hierarchical {*rxcsr_datsettlecyc_r*/Q}] \
                       -to   [get_pins -hierarchical {*/u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/D \
                                                      */u_rx_fifo/rx_fifo_queue.rx_fifo_queue_inst/wr_ctr*/SP}]

        if {$RX_FIFO_IMPL == "LUT"} {
          set_false_path -from [get_pins -hierarchical {*rx_fifo_queue_inst/*/*/*/_FABRIC*/*.dpram_inst/DO*}] \
                         -to   [get_pins -hierarchical {*rx_fifo_queue_inst/*/*/*/_FABRIC*/*.out_raw*/D}]
        }

      #--end of if {($RX_FIFO_TYPE == "QUEUE")} 
      }

      if {($RX_FIFO_TYPE == "PINGPONG")} {
        set_false_path -from [get_nets -hierarchical {*reset_pp*}]
	  
        if {$RX_FIFO_IMPL != "HARD_IP"} {
          set_false_path -from [get_pins -hierarchical {*wr_pp_sel*/Q}] \
                         -to   [get_pins -hierarchical {*rx_fifo_pp_inst/*/*/*/_FABRIC*/*full_r*/D \
                                                        *rx_fifo_pp_inst/*/*/*/_FABRIC*/*wr_addr_r*/D \
                                                        *rx_fifo_pp_inst/*/*/*/_FABRIC*/*wr_grey_sync_r*/D}]

          if {$RX_FIFO_IMPL == "LUT"} {
            set_false_path -from [get_pins -hierarchical {*wr_pp_sel*/Q}] \
                           -to   [get_pins -hierarchical {*rx_fifo_pp_inst/*/*/*/_FABRIC*/*.dpram_inst/WRE}]

            set_false_path -from [get_pins -hierarchical {*rx_fifo_pp_inst/*/*/*/_FABRIC*/*.dpram_inst/DO*}] \
                           -to   [get_pins -hierarchical {*rx_fifo_pp_inst/*/*/*/_FABRIC*/*.out_raw*/D}]


          } else {
            set_false_path -from [get_pins -hierarchical {*wr_pp_sel*/Q}] \
                           -to   [get_pins -hierarchical {*rx_fifo_pp_inst/*/*/*/_FABRIC*/*/*/*/*PDP*_MODE_inst/CSW* \
                                                          *rx_fifo_pp_inst/*/*/*/_FABRIC*/*/*/*/*PDP*_MODE_inst/CEW*}]

          }

        }
      
        if {($DPHY_RX_IP != "LATTICE")} {
          set_false_path -to [get_pins -hierarchical {*stb_data_neg*/CD}]
          set_false_path -to [get_pins -hierarchical {*wr_en_pp*_neg*/CD}]
        }
      #--end of if {($RX_FIFO_TYPE == "PINGPONG")}
      }

      if {($RX_FIFO_TYPE == "SINGLE")} {
        if {$RX_FIFO_IMPL == "LUT" && $FR_FIFO_CLKMODE == "DC"} {
          set_false_path -from [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/*.dpram_inst/DO*}] \
                         -to   [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/*.out_raw*/D}]
        }

      #--end of if {($RX_FIFO_TYPE == "SINGLE")}
      }

      if {($RX_FIFO_MISC == "ON")} {
        set_false_path -to [get_pins -hierarchical {*rx_fifo_errstat_inst/hs_sync_r*/CD \
                                                    *rx_fifo_errstat_inst/fifo*_dly_stb*/CD \
                                                    *rx_fifo_errstat_inst/fifo*_ovflw_stb*/CD}]
        set_false_path -to [get_pins -hierarchical {*rx_fifo_errstat_inst/stb_empty*_2ffsync/*/*/*.dout_cc*/CD}]
        set_false_path -from [get_pins -hierarchical {*rx_fifo_errstat_inst/fr_hssync_2ffsync/*/*/*.dout*/Q \
                                                      *rx_fifo_errstat_inst/hs_sync_q*/Q}] \
                       -to   [get_pins -hierarchical {*rx_fifo_errstat_inst/fifo*_ovflw_stb*/SP}]
      }
    
    #--end of if {$RX_FIFO == "ON"}
    }

    if {$RX_FIFO_IMPL != "HARD_IP"} {
      set_false_path -from [get_pins -hierarchical {*rxcsr_datsettlecyc_r*/Q}] \
                     -to   [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/*full_r*/D \
                                                    *u_rx_fifo/*/*/*/*/_FABRIC*/*wr_grey_sync_r*/D \
                                                    *u_rx_fifo/*/*/*/*/_FABRIC*/*wr_addr_r*/D}]

      if {$RX_FIFO_IMPL == "LUT"} {
        set_false_path -from [get_pins -hierarchical {*rxcsr_datsettlecyc_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/*.dpram_inst/WRE}]
      } else {
        set_false_path -from [get_pins -hierarchical {*rxcsr_datsettlecyc_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_FABRIC*/EBR*/*/*/*PDP*_MODE_inst/CSW* \
                                                      *u_rx_fifo/*/*/*/*/_FABRIC*/EBR*/*/*/*PDP*_MODE_inst/CEW}]

      }
    }

    set_false_path -to     [get_pins -hierarchical {*rx_fifo_errstat_inst/fr_hssync_2ffsync/*/*/*dout_cc*/D}]

  #--end of Avant
  }
#--end of CIL_BYPASS == "CIL_BYPASSED"
}

if {$LMMI == "ON"} {

  if {$CSRCMD_IMPL == "ASYNC"} {
    set_false_path -from [get_cells -hierarchical {*.u_lmmi}] -to [get_cells -hierarchical {*.u_csr}]
    set_false_path -from [get_cells -hierarchical {*.u_csr}] -to [get_cells -hierarchical {*.u_lmmi}]
    set_false_path -from [get_cells -hierarchical {*.u_lmmi}] -to [get_pins -hierarchical {*.u_csr/csr_rdata_r*/D*}]
    set_false_path -from [get_pins -hierarchical {*u_lmmi/lmmi_offset_q*/Q}] -through [get_nets -hierarchical {*u_lmmi/csr_addr_w*}]
    if {($FAMILY != "LAV-AT")} { 
      set_false_path -from [get_pins -hierarchical {*u_lmmi/lmmi_wr_rdn_q*/Q}] \
                     -to   [get_pins -hierarchical {*.u_csr/*/CE}]
    } else {
      set_false_path -from [get_pins -hierarchical {*u_lmmi/lmmi_wr_rdn_q*/Q}] \
                     -to   [get_pins -hierarchical {*.u_csr/*/SP}]
    }
    
  } else {
    if {($FAMILY == "LAV-AT")} { 

      set_false_path -from [get_pins -hierarchical {*u_csr/dphy_cfg_num_lanes*/Q}] \
                     -to   [get_pins -hierarchical {*u_csr/dphy_cfg_num_lanes_r*/D}]
      set_false_path -from [get_pins -hierarchical {*u_csr/rxcsr_datsettlecyc*/Q}] \
                     -to   [get_pins -hierarchical {*u_csr/rxcsr_datsettlecyc_r*/D}]

      set_max_delay -datapath_only -from [get_pins -hierarchical {*u_csr/rxcsr_datsettlecyc_r*/Q}] \
                                   -to   [get_pins -hierarchical {*u_dphy_rx_wrap/*hs_settle_en_r*/D}] $WR_1P8MAXDLY

      if {($RX_FIFO_TYPE != "QUEUE")} {
        set_false_path -from [get_pins -hierarchical {*u_csr/rxcsr_rxfifo_pktdly*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/rxcsr_rxfifo_pktdly_r*/D}]
      }

      if {($PARSER == "ON")} {
        set_false_path -from [get_pins -hierarchical {*u_csr/dphy_rxdatawidth_hs*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/dphy_rxdatawidth_hs_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/drop_blank_null_pkt_en*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/drop_blank_null_pkt_en_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/rxcsr_vcx_on*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/rxcsr_vcx_on_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/ref_dt*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/ref_dt_r*/D}]
      }

      # LSE keeps the registers even if unused.
      if {($PARSER == "ON" || $radiant(synthesis) == "lse")} {
        # Can be removed once standard library cell can automatically handle the case
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/vc_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/vc_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/wc_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/wc_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/dt_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/dt_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/vcx_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/vcx_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/ecc_r*/Q}] \
                        -to  [get_pins -hierarchical {*u_csr/ecc_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/payload_crc_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/pyldcrc_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/vc2_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/vc2_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/wc2_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/wc2_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/dt2_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/dt2_r*/D}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/ecc2_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/ecc2_r*/D}]
      # if {($PARSER == "ON")}
      }
    #if {($FAMILY == "LAV-AT")}
    } else { 

      set_false_path -from [get_pins -hierarchical {*u_csr/dphy_cfg_num_lanes*/Q}] \
                     -to   [get_pins -hierarchical {*u_csr/dphy_cfg_num_lanes_r*.ff_inst/DF}]

      if {$CIL_BYPASS == "CIL_ENABLED"} {
        set_multicycle_path -setup -from [get_pins  -hierarchical {*u_csr/dphy_cfg_num_lanes_r*.ff_inst/Q}] \
                                   -to   [get_cells -hierarchical {*u_dphy_rx_core_cil/fifo_rden*.ff_inst}] 2
        set_multicycle_path -hold  -from [get_pins  -hierarchical {*u_csr/dphy_cfg_num_lanes_r*.ff_inst/Q}] \
                                   -to   [get_cells -hierarchical {*u_dphy_rx_core_cil/fifo_rden*.ff_inst}] 1
        set_multicycle_path -setup -from [get_pins  -hierarchical {*u_csr/dphy_cfg_num_lanes_r*.ff_inst/Q}] \
                                   -to   [get_cells -hierarchical {*u_dphy_rx_core_cil/fifo_empty_r*.ff_inst}] 2
        set_multicycle_path -hold  -from [get_pins  -hierarchical {*u_csr/dphy_cfg_num_lanes_r*.ff_inst/Q}] \
                                   -to   [get_cells -hierarchical {*u_dphy_rx_core_cil/fifo_empty_r*.ff_inst}] 1
      }

      if {($CIL_BYPASS == "CIL_BYPASSED" || $DPHY_RX_IP == "LATTICE" )} {
        set_false_path -from [get_pins -hierarchical {*u_csr/rxcsr_datsettlecyc*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/rxcsr_datsettlecyc_r*.ff_inst/DF}]

        set_max_delay -datapath_only -from [get_pins -hierarchical {*u_csr/rxcsr_datsettlecyc_r*.ff_inst/Q}] \
                                     -to   [get_pins -hierarchical {*u_dphy_rx_wrap/*hs_settle_en_r*.ff_inst/DF}] $WR_1P8MAXDLY

        if {$DPHY_RX_IP == "LATTICE"} { 
          if {($radiant(synthesis) == "lse")} {
            set_false_path -from [get_pins -hierarchical {*u_csr/rxcsr_datsettlecyc_r*.ff_inst/Q}] \
                           -to   [get_pins -hierarchical {*u_rx_fifo/*/*/*/*/_HARD_IP*/*wr_pong_r*.ff_inst/DF}]
          }
        }

      }
      if {($RX_FIFO_TYPE != "QUEUE" && $CIL_BYPASS == "CIL_BYPASSED")} {
        set_false_path -from [get_pins -hierarchical {*u_csr/rxcsr_rxfifo_pktdly*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/rxcsr_rxfifo_pktdly_r*.ff_inst/DF}]
      }

      if {($PARSER == "ON")} {
        set_false_path -from [get_pins -hierarchical {*u_csr/dphy_rxdatawidth_hs*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/dphy_rxdatawidth_hs_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/drop_blank_null_pkt_en*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/drop_blank_null_pkt_en_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/rxcsr_vcx_on*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/rxcsr_vcx_on_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/ref_dt*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/ref_dt_r*.ff_inst/DF}]

        # Could be added for Non-Nexus too, but since fabric runs at higher speed in these devices,
        # okay to leave as is.
        set_multicycle_path -setup -from [get_pins  -hierarchical {*u_csr/dphy_rxdatawidth_hs_r*.ff_inst/Q \
                                                                   *u_csr/dphy_cfg_num_lanes_r*.ff_inst/Q}] \
                                   -to   [get_cells -hierarchical {*capture_ctrl_inst/*.ff_inst}] 2
        set_multicycle_path -hold -from  [get_pins  -hierarchical {*u_csr/dphy_rxdatawidth_hs_r*.ff_inst/Q \
                                                                   *u_csr/dphy_cfg_num_lanes_r*.ff_inst/Q}] \
                                   -to   [get_cells -hierarchical {*capture_ctrl_inst/*.ff_inst}] 1

        if {($CRC_CHECK == "ON")} {
          set_multicycle_path -setup -from [get_pins  -hierarchical {*u_csr/dphy_rxdatawidth_hs_r*.ff_inst/Q \
                                                                     *u_csr/dphy_cfg_num_lanes_r*.ff_inst/Q}] \
                                     -to   [get_cells -hierarchical {*lscc_crc_wrap_inst/*.ff_inst}] 2
          set_multicycle_path -hold -from  [get_pins  -hierarchical {*u_csr/dphy_rxdatawidth_hs_r*.ff_inst/Q \
                                                                     *u_csr/dphy_cfg_num_lanes_r*.ff_inst/Q}] \
                                     -to   [get_cells -hierarchical {*lscc_crc_wrap_inst/*.ff_inst}] 1
        }

      }
      # LSE keeps the registers even if unused.
      if {($PARSER == "ON" || $radiant(synthesis) == "lse")} {
        # Can be removed once standard library cell can automatically handle the case
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/vc_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/vc_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/wc_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/wc_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/dt_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/dt_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/vcx_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/vcx_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/ecc_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/ecc_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/payload_crc_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/pyldcrc_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/vc2_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/vc2_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/wc2_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/wc2_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/dt2_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/dt2_r*.ff_inst/DF}]
        set_false_path -from [get_pins -hierarchical {*u_csr/*lscc_csr_cdc_inst/ecc2_r*/Q}] \
                       -to   [get_pins -hierarchical {*u_csr/ecc2_r*.ff_inst/DF}]
      #--end of if {($PARSER == "ON")}
      }
    #--end of Nexus
    }
  #--end of CSRCMD_IMPL == "SYNC"
  }
#--end of $LMMI == "ON"
}

#----- 
} 
