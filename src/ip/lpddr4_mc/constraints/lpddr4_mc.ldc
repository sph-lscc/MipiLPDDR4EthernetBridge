##================================== Generate Clocks ======================================##
if {($PLL_EN)} {
#    set CLK_PERIOD [expr {double(round(1000/$CLKI_FREQ))}]
#    create_clock -name {pll_refclk_i} -period $CLK_PERIOD [get_ports pll_refclk_i]
    ldc_set_port -iobuf IO_TYPE=$PLL_IO_TYPE [get_ports pll_refclk_i]
}
##=========================================================================================##


##=========================================================================================##
#### IO_TYPE constraints                                                                 ####
##=========================================================================================##

##================================== DQS/DQ IO Type =======================================##
for {set i 0} {$i < $DQS_WIDTH} {incr i} {
    ldc_set_port -iobuf IO_TYPE=$CK_DQS_IO\ DRIVE=$MC_DQ_DRV\ SLEWRATE=$DQS_SLEW_RATE\ TERMINATION=$MC_ODT_VAL [get_ports ddr_dqs_io\[$i\]]
}
for {set i 0} {$i < $BUS_WIDTH} {incr i} {
    ldc_set_port -iobuf IO_TYPE=$IO_TYPE\ DRIVE=$MC_DQ_DRV\ SLEWRATE=$DQ_SLEW_RATE\ TERMINATION=$MC_ODT_VAL [get_ports ddr_dq_io\[$i\]]
}

##=================================== Data Mask ===========================================##
for {set i 0} {$i < $DQS_WIDTH} {incr i} {
    ldc_set_port -iobuf IO_TYPE=$IO_TYPE\ DRIVE=$MC_DQ_DRV\ SLEWRATE=$DQ_SLEW_RATE\ TERMINATION=$MC_ODT_VAL [get_ports ddr_dmi_io\[$i\]]
}


##============================ Clock Address and Command ==================================##

for {set i 0} {$i < $CK_WIDTH} {incr i} {
    ldc_set_port -iobuf IO_TYPE=$CK_DQS_IO\ DRIVE=$MC_CA_DRV\ SLEWRATE=$CK_SLEW_RATE [get_ports ddr_ck_o\[$i\]]
}

for {set i 0} {$i < $CS_WIDTH} {incr i} {
    ldc_set_port -iobuf IO_TYPE=$IO_TYPE\ DRIVE=$MC_CA_DRV\ SLEWRATE=$CA_SLEW_RATE [get_ports ddr_cke_o\[$i\]]
}
for {set i 0} {$i < $CS_WIDTH} {incr i} {
    ldc_set_port -iobuf IO_TYPE=$IO_TYPE\ DRIVE=$MC_CA_DRV\ SLEWRATE=$CK_SLEW_RATE [get_ports ddr_cs_o\[$i\]]
}
  
for {set i 0} {$i < $CA_WIDTH} {incr i} {
    ldc_set_port -iobuf IO_TYPE=$IO_TYPE\ DRIVE=$MC_CA_DRV\ SLEWRATE=$CA_SLEW_RATE [get_ports ddr_ca_o\[$i\]]
}
if {$DDR_TYPE == 0} {
    for {set i 0} {$i < $ODT_WIDTH} {incr i} {
        ldc_set_port -iobuf IO_TYPE=$IO_TYPE\ DRIVE=$MC_CA_DRV\ SLEWRATE=$CA_SLEW_RATE [get_ports ddr_odt_o\[$i\]]
    }
}

ldc_set_port -iobuf IO_TYPE=$IO_TYPE\ DRIVE=$MC_CA_DRV [get_ports ddr_reset_n_o]

##=========================================================================================##
