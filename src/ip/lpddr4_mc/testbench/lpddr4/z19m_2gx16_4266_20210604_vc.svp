// LPDDR4 Configuration of per channel  
// Parameter for 2Gb x16DQ 

   `define   LPDDR4_TOP         lpddr4_2g_x16_ch
   `define   LPDDR4_ins_ch1     ins_1ch
   `define   MEM_SIZE_ch       "2Gb"
   `define   PRODUCT_CODE      "z19m"
   
   `define   ca_wid            6 
   `define   io_wid           16   
   `define   bank_wid          3 
   `define   row_max_wid      17 
   `define   row_wid          14 
   `define   col_wid          10 
 
   `define   addr_wid          5 

   `define   row_size         ( 1 << `row_wid )
   `define   row_max_size     ( 1 << `row_max_wid )
   `define   bank_size        ( 1 << `bank_wid )

   `define   dqs_wid         `io_wid/8
   `define   dmi_wid         `io_wid/8

   `define   mem_col_addr     5
   `define   mem_col_size     ( 1 << `mem_col_addr )

   `define   mem_wid          `row_wid + `mem_col_addr
   `define   mem_size         `row_size * `mem_col_size

   `define   mem_io_wid       `io_wid *`BL_max
   `define   mem_dmi_wid      `dmi_wid*`BL_max

