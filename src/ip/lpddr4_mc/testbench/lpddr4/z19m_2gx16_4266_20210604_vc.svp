         $display("An error occurred, but continues simulation. When using lpddr4_proc option, this verilog model doesn't guarantee movement a lpddr4 device.");
      `else
         $display("When an error has occurred, a simulation is suspended.");
      `endif

      `ifdef lpddr4_x8_lm_support
         $display("DRAM supports byte mode latency.");
      `endif

   end

