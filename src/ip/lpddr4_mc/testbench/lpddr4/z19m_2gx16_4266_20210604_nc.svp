// Other define      
   `define  error_stop           `LPDDR4_TOP.error_stop='1

   `ifdef lpddr4_err_msg_disable
        `define  msg(x)
   `else 
        `define  msg(x)               if( RESET_n !== `L ) begin  $display("Error: %m %0t  %-0s",$realtime , x );`error_stop;  end
   `endif

   `define  warning_msg(x)       if( RESET_n !== `L ) begin  $display("Warning: %m %0t  %-0s",$realtime , x );    end
   `define  normal_msg(x)        if( RESET_n !== `L ) begin  $display("Information:  %m %0t  %-0s",$realtime , x );    end
   `define  Disp_Err_Msg( x )    `msg( x );    
   `define  FOR_ROW_BANK( FIN )  for( row_bank_num = 0; row_bank_num < FIN ; row_bank_num = row_bank_num + 1 ) 
   `define  FOR_COL_BANK( FIN )  for( col_bank_num = 0; col_bank_num < FIN ; col_bank_num = col_bank_num + 1 ) 
   `define  FOR_LOOP_BANK(x)     for( x =  0  ;x < `bank_size  ; x = x + 1 )   
 
   `define  L 1'b0 
   `define  H 1'b1 
   `define  X 1'bx 
   `define  Z 1'bz        
 
 
   //----------------------------------------- 
   `define STATE_POW0      (  state[0]   == "POW0" &&  state[1]   == "POW0" && state[2]   == "POW0" && state[3]   == "POW0" && state[4]   == "POW0" &&  state[5]   == "POW0" && state[6]   == "POW0" && state[7]   == "POW0" )   
   `define STATE_POW1      (  state[0]   == "POW1" &&  state[1]   == "POW1" && state[2]   == "POW1" && state[3]   == "POW1" && state[4]   == "POW1" &&  state[5]   == "POW1" && state[6]   == "POW1" && state[7]   == "POW1" )  
   `define STATE_POW2      (  state[0]   == "POW2" &&  state[1]   == "POW2" && state[2]   == "POW2" && state[3]   == "POW2" && state[4]   == "POW2" &&  state[5]   == "POW2" && state[6]   == "POW2" && state[7]   == "POW2" )  
   `define STATE_POW3      (  state[0]   == "POW3" &&  state[1]   == "POW3" && state[2]   == "POW3" && state[3]   == "POW3" && state[4]   == "POW3" &&  state[5]   == "POW3" && state[6]   == "POW3" && state[7]   == "POW3" )        
   `define STATE_SELF      (  state[0]   == "SELF" &&  state[1]   == "SELF" && state[2]   == "SELF" && state[3]   == "SELF" && state[4]   == "SELF" &&  state[5]   == "SELF" && state[6]   == "SELF" && state[7]   == "SELF" )  
   `define STATE_SRPD      (  state[0]   == "SRPD" &&  state[1]   == "SRPD" && state[2]   == "SRPD" && state[3]   == "SRPD" && state[4]   == "SRPD" &&  state[5]   == "SRPD" && state[6]   == "SRPD" && state[7]   == "SRPD" )        
   `define STATE_IDLE      (  state[0]   == "IDLE" &&  state[1]   == "IDLE" && state[2]   == "IDLE" && state[3]   == "IDLE" && state[4]   == "IDLE" &&  state[5]   == "IDLE" && state[6]   == "IDLE" && state[7]   == "IDLE" )  
   `define STATE_RSET      (  state[0]   == "RSET" &&  state[1]   == "RSET" && state[2]   == "RSET" && state[3]   == "RSET" && state[4]   == "RSET" &&  state[5]   == "RSET" && state[6]   == "RSET" && state[7]   == "RSET" )  
   `define STATE_NOT_POW0  (  state[0]  !== "POW0" ||  state[1]  !== "POW0" || state[2]  !== "POW0" || state[3]  !== "POW0" || state[4]  !== "POW0" ||  state[5]  !== "POW0" || state[6]  !== "POW0" || state[7]  !== "POW0" )  
   `define STATE_NOT_POW1  (  state[0]  !== "POW1" ||  state[1]  !== "POW1" || state[2]  !== "POW1" || state[3]  !== "POW1" || state[4]  !== "POW1" ||  state[5]  !== "POW1" || state[6]  !== "POW1" || state[7]  !== "POW1" )  
   `define STATE_NOT_POW2  (  state[0]  !== "POW2" ||  state[2]  !== "POW2" || state[2]  !== "POW2" || state[3]  !== "POW2" || state[4]  !== "POW2" ||  state[5]  !== "POW2" || state[6]  !== "POW2" || state[7]  !== "POW2" )  
   `define STATE_NOT_IDLE  (  state[0]  !== "IDLE" ||  state[1]  !== "IDLE" || state[2]  !== "IDLE" || state[3]  !== "IDLE" || state[4]  !== "IDLE" ||  state[5]  !== "IDLE" || state[6]  !== "IDLE" || state[7]  !== "IDLE" )    
   `define STATE_NOT_SELF  (  state[0]  !== "SELF" ||  state[1]  !== "SELF" || state[2]  !== "SELF" || state[3]  !== "SELF" || state[4]  !== "SELF" ||  state[5]  !== "SELF" || state[6]  !== "SELF" || state[7]  !== "SELF" ) 

   `define STATE_ACTV      (  state[0]   == "ACTV" ||  state[1]   == "ACTV" || state[2]   == "ACTV" || state[3]   == "ACTV" || state[4]   == "ACTV" ||  state[5]   == "ACTV" || state[6]   == "ACTV" || state[7]   == "ACTV" )        

   //----------------------------------------- 
   // tREFW check
   `ifdef lpddr4_trefw_err_off
      `define   tREFW_chk_enable    0
   `else
      `define   tREFW_chk_enable    1
   `endif
   // tREFIab/pb check
   `ifdef lpddr4_trefi_err_off
      `define   tREFI_chk_enable    0
   `else
      `define   tREFI_chk_enable    1
   `endif
   // tRFCab/pb check
   `ifdef lpddr4_trfc_err_off
      `define   tRFC_chk_enable    0
   `else
      `define   tRFC_chk_enable    1
   `endif

   // Other Refresh check
   //(1) REFpb 8bank entry chek
   `ifdef lpddr4_other_ref_err_off
      `define   REFpb_8bank_entry_chk_enable    0
   `else
      `define   REFpb_8bank_entry_chk_enable    1
   `endif
   

   //----------------------------------------- 




`timescale  1ns / 100fs


module   lpddr4_16 (

      CK_t,     CK_c,             //    Input
      CKE,                        //    Input
      CS,                         //    Input
      CA,                         //    Input
      ODT_CA,                     //    Input
      DQ,                         //    I/O
      DQS_t,    DQS_c,            //    I/O
      DMI,                        //    I/O
      RESET_n,                    //    Input
      ZQ                          //    output

   );

   input                   CK_t,     CK_c;
   input                   CKE     ;
   input                   CS      ;
   input [`ca_wid-1:0]     CA      ;
   input                   ODT_CA  ;
   inout [`io_wid -1:0]    DQ      ;
   inout [`dqs_wid-1:0]    DQS_t,    DQS_c;
